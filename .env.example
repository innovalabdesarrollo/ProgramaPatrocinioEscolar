# Node >=22 (local recomendado >=24.22.1 por parches Node2Shell)

# MongoDB Atlas — una sola URI; el nombre de DB va en la URI (no mezclar DBs)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mapa_cobertura_patrocinio_escolar?retryWrites=true&w=majority

# —— Local ——
PORT=3061
WEB_PORT=5210
CORS_ORIGIN=http://localhost:5210,http://127.0.0.1:5210
PUBLIC_API_URL=http://localhost:3061

# —— Vercel (Project → Settings → Environment Variables) ——
# Obligatorias en Production / Preview:
#   MONGODB_URI=...
#   SESSION_SECRET=...secreto-largo...
# Opcionales (tienen default):
#   VISITS_DAILY_CAP=3
#   ALERT_WAIT_DAYS=14
#   ALERT_CAMPAIGN_PCT=70
#   CORS_ORIGIN=https://tu-dominio.vercel.app
# NO hace falta PUBLIC_API_URL en Vercel (mismo origen: /api)
# VERCEL_URL se inyecta solo y se agrega a CORS

SESSION_SECRET=cambia-este-secreto-local

VISITS_DAILY_CAP=3
ALERT_WAIT_DAYS=14
ALERT_CAMPAIGN_PCT=70
